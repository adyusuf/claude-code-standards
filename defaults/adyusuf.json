{
  "mode": "C",
  "mode_model": "sonnet",
  "monitor": { "connect": true, "message_format": "short" },
  "write": { "unit_tests": true, "e2e": true },
  "merge": { "dev": true, "test": true, "prod": true },
  "push": { "dev": true, "test": true, "prod": true },
  "run_before_push": {
    "dev": { "unit": false, "e2e": false },
