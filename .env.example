# claude-code-standards — optional settings (rule #16, SETUP.md §4)
#
# Nothing reads a .env file: these are plain shell variables, set in your shell
# or on the command line, e.g.  COVERAGE_MIN=80 bash scripts/coverage.sh
# This file only lists them. Nothing loads it, and there is no secret in it.
# Every variable is OPTIONAL; the default is what happens when it is unset.

# --- Coverage ---
COVERAGE_VENV=            # Python venv holding `coverage`. Default: ~/.cache/claude-standards/venv
COVERAGE_MIN=             # Line-coverage threshold per codebase, percent. Default: 80. Rule #29 forbids lowering it

# --- Real-name check (scripts/real-name-check.sh) ---
REAL_NAMES_MAP=           # Path of the local, git-ignored map. Default: docs/project-nicknames.tsv in this or the main worktree
REAL_NAMES_STRICT=        # 1 = a missing map fails the commit. Default: 0 (a missing map only warns)

# --- Gate (scripts/gate-core.sh) ---
GATE_PARALLEL_NODE=       # 1 = run the Node track in parallel. Default: 0. Meaningful only for a codebase with Node
TEST_VERSION_URL=         # Version endpoint of a test deployment the gate may curl. Not a secret. Default: unset (no request is made)
TEST_DEPLOY_SHA_CMD=      # Command printing the deployed SHA. Default: set in scripts/merge-gate.conf (git ls-remote origin refs/heads/test)
E2E_WEB_CMD=              # Command that runs the web e2e suite. Default: unset. This repository has no e2e suite
E2E_MOBILE_CMD=           # Command that runs the mobile e2e suite. Default: unset. This repository has no e2e suite

# --- Live board (only if you use it; code lives in the claude-monitor repository) ---
CLAUDE_MONITOR_HOME=      # Where the launchers look for the claude-monitor clone, and where install.py --with-monitor clones it. Default: ~/ClaudeCode/claude-monitor
CM_AGENT_HOME=            # claude-monitor's agent home; install.py --with-monitor reads it to find cm-agent. Default: macOS ~/Library/Application Support/ClaudeMonitor, Windows %USERPROFILE%\.claude-monitor (not AppData: the Claude desktop app redirects it); an install in the old Windows default %LOCALAPPDATA%\ClaudeMonitor is still found
